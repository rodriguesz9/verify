# Google AI Studio: modelo explícito, sem rotação para modelos antigos
APP_ENV="development"              # Railway: production; exige JWT_SECRET forte
GEMINI_API_KEY=""
GEMINI_MODEL_NAME="gemini-3.7-flash"
GEMINI_FALLBACK_MODELS=""          # opcional: um modelo habilitado na sua conta
GEMINI_TTS_MODEL="gemini-3.8-flash-tts"

# OpenRouter (cliente legado/opcional; NÃO decide veracidade no fluxo principal)
OPENROUTER_API_KEY=""               # chave de API do openrouter.ai
# OPENROUTER_MODEL=""               # somente se usar explicitamente o cliente alternativo

# Fact Checking
GOOGLE_FACT_CHECK_KEY=""

# Forense de Mídia
SIGHTENGINE_API_USER=""
SIGHTENGINE_API_SECRET=""
SIGHTENGINE_AUDIO_ENABLED="false" # opt-in: ai_speech requer acesso enterprise/parceiro; chave de imagem não garante acesso
VIDEO_MAX_FRAMES="9"              # máximo de 3 a 12; aumenta cobertura/custo, não comprova lip-sync
HUGGINGFACE_API_TOKEN=""
HUGGINGFACE_IMAGE_API_URL=""       # endpoint HTTPS oficial do modelo realmente hospedado na sua conta
HUGGINGFACE_AI_LABEL="artificial" # classe positiva EXATA do modelo, confirmada na documentação/treinamento
# Sem endpoint confirmado, a camada não faz chamadas e continua indisponível.

# Auth cookies: set true when served through HTTPS.
COOKIE_SECURE="false"
# Use "none" with COOKIE_SECURE="true" when the frontend and API use
# different HTTPS domains (for example Vercel + Railway).
COOKIE_SAME_SITE="lax"

# Contexto e Texto
SERPERAPI_KEY=""
SERPAPI_KEY=""

# Novas Camadas Forenses
HIVE_API_KEY=""                    # compatibilidade: chave de UM projeto/modelo Hive
HIVE_IMAGE_API_KEY=""              # projeto de detecção de imagem (também usado nos quadros de vídeo)
HIVE_DEEPFAKE_API_KEY=""           # projeto de manipulação facial; não usa a chave legada como fallback
HIVE_AUDIO_API_KEY=""              # projeto específico de detecção de áudio
HIVE_TEXT_API_KEY=""               # projeto específico de detecção de texto
EXIFTOOL_ENABLED="true"            # extração de metadata (sem API key, lib local)
C2PATOOL_ENABLED="true"            # verificação de content credentials (sem API key)
C2PATOOL_TRUST_ANCHORS=""          # arquivo local de âncoras confiáveis; presença de marcador não valida assinatura
TINEYE_API_KEY=""                  # reverse image search redundante
WAYBACK_API_ENABLED="true"         # checagem de origem histórica (sem API key)
ASSEMBLYAI_API_KEY=""              # transcrição alternativa; não comprova clonagem de voz
GPTZERO_API_KEY=""                 # detecção complementar de texto gerado por IA
VIRUSTOTAL_API_KEY=""              # reputação de URLs (opcional, roadmap futuro)
MIN_CONFIDENCE_THRESHOLD="0.75"    # compatibilidade legada; política de mídia experimental definida em evidence_policy.py
HMAC_SECRET_KEY=""               # gere um valor aleatório com pelo menos 32 caracteres
JWT_SECRET=""                    # gere um valor aleatório com pelo menos 32 caracteres
GOOGLE_CLIENT_ID=""               # necessário somente para login com Google
CORS_ORIGINS="http://localhost:5173"
# Opcional: habilita previews Vercel sem liberar qualquer origem.
CORS_ORIGIN_REGEX=""              # prefira CORS_ORIGINS com o domínio EXATO do seu frontend

# Limites locais por processo/IP. Use armazenamento compartilhado antes de escalar.
ANALYSIS_REQUESTS_PER_MINUTE="10"
ANALYSIS_GLOBAL_REQUESTS_PER_MINUTE="60"
ANALYSIS_MAX_CONCURRENT="4"        # no máximo duas solicitações simultâneas por IP
API_MAX_BODY_BYTES="36700160"      # 35 MiB no envio completo; cada arquivo continua limitado a 25 MiB

# ── Bot de WhatsApp (Módulo 2 - Evolution API / webhook) ──────────────────────
WHATSAPP_BOT_ENABLED="false"     # habilita o webhook; nunca habilita acesso sem autenticação
WHATSAPP_WEBHOOK_SECRET=""       # >=32 caracteres; gateway envia no header X-Verify-Webhook-Secret
WHATSAPP_HISTORY_ENABLED="false" # armazenamento opcional e pseudonimizado; mensagens podem conter dados pessoais
WHATSAPP_HASH_SECRET=""          # >=32 caracteres, independente do segredo do webhook e do JWT
EVOLUTION_API_URL=""             # URL pública da instância Evolution (ex: http://localhost:8090)
EVOLUTION_API_KEY=""             # AUTHENTICATION_API_KEY da instância Evolution
EVOLUTION_INTERNAL_URL=""        # URL interna (docker) da Evolution, ex: http://evolution-api:8080
